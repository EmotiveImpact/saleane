{
  "name": "saleane",
  "private": true,
  "version": "1.0.0-rc.1",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader bundle --host 127.0.0.1",
    "build": "tsc -b && vite build --configLoader bundle && vite build --configLoader bundle --ssr server/index.ts --outDir server-dist && vite build --configLoader bundle --ssr server/backup.ts --outDir server-dist --emptyOutDir false",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run && vitest run --config server/vitest.config.ts",
    "test:watch": "vitest",
    "preview": "vite preview --host 127.0.0.1",
    "demo:build": "npm --prefix demo ci --no-audit --no-fund && vite build --configLoader bundle --config demo/vite.config.ts",
    "check": "npm run lint && npm run test && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "node server-dist/index.js",
    "db:backup": "node server-dist/backup.js"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-popover": "^1.2.0",
    "@radix-ui/react-tabs": "^1.1.22",
    "@radix-ui/react-toggle-group": "^1.1.20",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10"
  }
}
